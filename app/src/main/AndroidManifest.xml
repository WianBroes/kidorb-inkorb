<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Uniquement Android ≤ 9 (API 28) : export PNG / sauvegarde profils vers
         le stockage public (galerie, Téléchargements). Sans effet sur Android
         10+ (API 29+), qui utilise MediaStore en scoped storage sans permission
         — la déclaration "zéro permission" reste vraie pour l'écrasante
         majorité des appareils réels. Ajoutée le 29/08 suite à un plantage au
         lancement sur un Redmi Android < 10 (cf. CHANGELOG.md). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.KidOrb">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
