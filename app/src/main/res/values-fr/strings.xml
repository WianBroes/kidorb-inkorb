    <string name="tuto_step2_title">Choisir sa bille</string>
    <string name="tuto_step2_body">Le bouton rond « Bille » ouvre ta liste de billes — tape sur une pour l\'utiliser.</string>
    <string name="tuto_step3_title">Agrandir bille, pinceau, gomme</string>
