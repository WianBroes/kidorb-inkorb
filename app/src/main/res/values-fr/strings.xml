    <string name="tuto_step5_body">Un tap pose la forme aussitôt à sa taille par défaut — sans relâcher, glisse pour l\'agrandir.</string>
    <string name="tuto_step4_title">La flèche</string>
    <string name="tuto_step4_body">La flèche attrape la bille pour la déplacer, et modifie un obstacle ou un effet déjà posé (bouger, redimensionner, supprimer).</string>
    <string name="tuto_step_scroll_title">Plus de couleurs</string>
    <string name="tuto_step_scroll_body">Glisse le doigt de haut en bas sur les pastilles de couleur pour faire défiler toute la palette.</string>

