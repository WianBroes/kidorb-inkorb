    <string name="btn_replay_tuto">Replay tutorial</string>
    <string name="tuto_done">Got it</string>
    <string name="tuto_step2_title">Choosing a ball</string>
    <string name="tuto_step2_body">The round \"Ball\" button opens your list of balls — tap one to use it.</string>
    <string name="tuto_step3_title">Resizing ball, brush, eraser</string>
    <string name="tuto_step3_body">Drag up or down on the Ball, Brush and Eraser buttons to change their size.</string>
    <string name="tuto_step5_title">Placing an obstacle or effect</string>
    <string name="tuto_step5_body">A tap places the shape right away at its default size — without letting go, drag to make it bigger.</string>
    <string name="tuto_step4_title">The arrow</string>
    <string name="tuto_step4_body">The arrow grabs the ball to move it, and edits an obstacle or effect already placed (move, resize, delete).</string>
    <string name="tuto_step_scroll_title">More colors</string>
    <string name="tuto_step_scroll_body">Drag your finger up or down on the color swatches to scroll through the whole palette.</string>

